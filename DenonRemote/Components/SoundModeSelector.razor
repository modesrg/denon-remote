        <div class="channel ch-fl">
            <div class="channel-bar"><div class="channel-bar-fill"></div></div>
            <span class="channel-label">FL</span>
        </div>
        <div class="channel ch-c">
            <div class="channel-bar"><div class="channel-bar-fill"></div></div>
            <span class="channel-label">C</span>
        </div>
        <div class="channel ch-fr">
            <div class="channel-bar"><div class="channel-bar-fill"></div></div>
            <span class="channel-label">FR</span>
        </div>
        <div class="channel ch-sl">
            <div class="channel-bar"><div class="channel-bar-fill"></div></div>
