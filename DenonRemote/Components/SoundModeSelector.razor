        </div>
        <div class="channel ch-sr">
            <div class="channel-bar"><div class="channel-bar-fill"></div></div>
            <span class="channel-label">SR</span>
        </div>
        <div class="channel ch-sub">
            <div class="channel-bar"><div class="channel-bar-fill"></div></div>
            <span class="channel-label">SUB</span>
        </div>
    </div> *@
</div>

@code {
    private SoundFamily _family  = SoundFamily.Stereo;
    private string?     _infoKey = null;

    private string Mode         => StateService.CurrentState.SoundMode;
    private bool   IsAutoActive => Mode.Equals(Commands.SoundMode.Auto, StringComparison.OrdinalIgnoreCase);
    private bool   IsActive(string key) => Mode.Equals(key, StringComparison.OrdinalIgnoreCase);

    private void SelectAuto()
    {
        _infoKey = null;
        Denon.SetSoundModeAsync(Commands.SoundMode.Auto);
    }

    private void SelectMode(string key)
    {
        _infoKey = null;
        Denon.SetSoundModeAsync(key);
    }

    private void ToggleInfo(string key) =>
        _infoKey = _infoKey == key ? null : key;

    private void SelectFamily(SoundFamily family)
    {
        _family  = family;
        _infoKey = null;
        if (!Commands.SoundMode.All.Any(kv => kv.Value.Family == family && IsActive(kv.Key)))
        {
            var firstKey = Commands.SoundMode.All
                .FirstOrDefault(kv => kv.Value.Family == family).Key;
            if (firstKey is not null)
                Denon.SetSoundModeAsync(firstKey);
        }
    }

    protected override void OnInitialized()
    {
        StateService.StateChanged += OnStateChanged;
        SyncFamilyFromState();
    }

    private void SyncFamilyFromState()
    {
        if (Commands.SoundMode.All.TryGetValue(Mode, out var def))
            _family = def.Family;
    }

    private async void OnStateChanged(ReceiverState _)
    {
        SyncFamilyFromState();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => StateService.StateChanged -= OnStateChanged;
}
