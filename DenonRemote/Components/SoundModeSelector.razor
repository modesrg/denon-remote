@using DenonRemote.Constants
@using DenonRemote.Services.Interfaces
@inject IReceiverStateService StateService
@inject DenonService Denon
@implements IDisposable

<div class="section">
    <span class="section-label">Sound Mode</span>

    <button class="auto-btn @(IsAutoActive ? "active" : "")"
            @onclick="SelectAuto">
        <div class="auto-btn-left">
            <span class="auto-btn-label">AUTO</span>
            <span class="auto-btn-desc">Receiver selects the best mode for the signal</span>
        </div>
        @if (IsAutoActive)
        {
            <span class="auto-badge">active</span>
        }
    </button>

    <div class="mode-tabs">
        <button class="mode-btn @(_family == SoundFamily.Stereo ? "active" : "")"
                @onclick="() => SelectFamily(SoundFamily.Stereo)">
            <div class="mode-icon stereo">
                <div class="speaker-dot"></div>
                <div class="speaker-dot"></div>
            </div>
            <span class="mode-name">STEREO</span>
            <span class="mode-desc">Pure 2.0</span>
        </button>
        <button class="mode-btn @(_family == SoundFamily.Surround ? "active" : "")"
                @onclick="() => SelectFamily(SoundFamily.Surround)">
            <div class="mode-icon surround">
                <div class="speaker-dot"></div>
                <div class="speaker-dot"></div>
                <div class="speaker-dot"></div>
                <div class="speaker-dot"></div>
                <div class="speaker-dot"></div>
                <div class="speaker-dot"></div>
            </div>
            <span class="mode-name">SURROUND</span>
            <span class="mode-desc">Dolby / DTS</span>
        </button>
    </div>

    <div class="sub-mode-grid">
        @foreach (var (key, def) in Commands.SoundMode.All.Where(kv => kv.Value.Family == _family))
        {
            var capturedKey = key;
            <button class="sub-mode-btn @(IsActive(capturedKey) ? "active" : "")"
                    @onclick="() => SelectMode(capturedKey)">
                <span class="sub-mode-label">@def.Label</span>
                <span class="info-toggle @(_infoKey == capturedKey ? "open" : "")"
                      @onclick="() => ToggleInfo(capturedKey)"
                      @onclick:stopPropagation>ⓘ</span>
            </button>
        }
    </div>

    @if (_infoKey is not null && Commands.SoundMode.All.TryGetValue(_infoKey, out var infoDef))
    {
        <div class="mode-info-panel">@infoDef.Description</div>
    }

